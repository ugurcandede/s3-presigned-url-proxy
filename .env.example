# Host port the proxy is published on (docker-compose). Container always listens on 8088.
# Keep this off your UI's port to avoid a collision (e.g. UI on 8088 -> proxy on 8087).
PROXY_HOST_PORT=8087

# AWS Configuration
AWS_REGION=us-east-1
AWS_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Pre-signed URL expiration time in seconds (default: 14400 = 4 hours)
PRESIGNED_URL_EXPIRATION=14400

# Request Configuration
# Comma-separated query params that must be present (missing -> HTTP 400)
REQUIRED_PARAMS=objectkey
# Which query param's value is used as the S3 object key
OBJECT_KEY_PARAM=objectkey

# Example: enforce an extra "tenant" param alongside the object key
# REQUIRED_PARAMS=tenant,objectkey

# Optional. If another app shares this hostname on a different port, requests that
# are missing REQUIRED_PARAMS are 302'd to the same URL on this port instead of
# returning 400. Leave empty to disable.
# PASSTHROUGH_PORT=8088
